# --- Outside-In Brain API ---
# Base URL of the API including the /api prefix
API_URL=http://localhost:3101/api
# Must match PIPELINE_SECRET on the API
PIPELINE_SECRET=change-me

# --- Claude (issue writer) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Max output tokens for the issue JSON (takeaways + full podcast transcript)
ANTHROPIC_MAX_TOKENS=16000

# --- Text to speech ---
# openai (default) | elevenlabs | none
TTS_PROVIDER=openai
OPENAI_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE_IN=alloy
TTS_VOICE_AN=onyx
# ElevenLabs alternative
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_IN=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_AN=pNInY2qX0ZeLKzXwGjkP
ELEVENLABS_MODEL=eleven_multilingual_v2
# Parallel TTS requests
TTS_CONCURRENCY=4

# --- Triggerware (optional; pipeline runs without it) ---
# TCP host:port (e.g. localhost:5221 or triggerware.railway.internal:5221) or ws(s):// URL
TRIGGERWARE_URL=
# Only needed for ws(s):// URLs
TRIGGERWARE_API_KEY=
# Schedule string for the oib_digest_check trigger
TRIGGERWARE_SCHEDULE=*/15 * * * *
# URL at which Triggerware can reach this worker's HTTP server (enables the oib_runs table)
PIPELINE_SELF_URL=

# --- Worker ---
TICK_MINUTES=15
# HTTP server for /health, /runs and POST /run (Railway injects PORT)
PORT=8080
LOG_LEVEL=info
