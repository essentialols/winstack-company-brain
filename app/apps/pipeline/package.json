{
  "name": "@app-starter/pipeline",
  "version": "0.0.0",
  "private": true,
  "description": "Outside-In Brain pipeline: due brains -> Claude issue -> two-voice podcast -> publish",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "once": "tsx src/once.ts",
    "once:prod": "node dist/once.js",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@app-starter/shared": "workspace:*",
    "triggerware": "^1.1.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
